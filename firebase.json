{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "**/__pycache__/**",
      "update_xsmb.py",
      "*.md"
    ],
    "headers": [
      { "source": "/data.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(html|js|css)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
